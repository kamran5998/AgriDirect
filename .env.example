# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Base URL for Python FastAPI REST backend service
VITE_API_BASE_URL=http://localhost:8000/api

# Database Configuration (MySQL / PostgreSQL / SQLite)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agridirect_db
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/agridirect_db?charset=utf8mb4

# JWT Auth Secret
JWT_SECRET_KEY=super_secret_dev_key_agridirect_2026_pulse_change_in_prod

# Market Data Ingestion Provider ('mock' | 'agmarknet' | 'data_gov_in')
MARKET_DATA_PROVIDER=mock
AGMARKNET_API_KEY=
DATA_GOV_IN_API_KEY=

# Real OTP / SMS Gateway Configuration (Supported: 'fast2sms' | 'twilio' | 'msg91' | 'dev_simulation')
OTP_PROVIDER=fast2sms
OTP_API_KEY=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

